# =============================================================================
# Log  File Resolver (Derived from Environment)
# =============================================================================
resolve_logfile() {
    local svc="$1" lf="" env_lf=""
    if [[ -f "${ENV_FILES[$svc]}" ]]; then
        env_lf=$(grep -E '^[[:space:]]*LOGFILE=' "${ENV_FILES[$svc]}" \
            | tail -n1 | sed 's/^[^=]*=//; s/^["'\'']//; s/["'\'']$//' || true)
    fi
    lf=$(systemctl cat "${svc}.service" 2>/dev/null \
        | sed -n 's/.*--logfile[ =]\([^ ]*\).*/\1/p' | head -n1 || true)
    [[ "$lf" == *'$'* ]] && lf="$env_lf"
    [[ -z "$lf" ]] && lf="$env_lf"
    printf '%s' "$lf"
}

# =============================================================================
# Config File Resolver (Derived from Environment)
# =============================================================================
resolve_config_from_env() {
    local svc="svxlink"
    local env_file="${ENV_FILES[$svc]}"
    local found_config_path=""
    local found_handler_path=""
    local key value

    # --- STEP 1: Resolve Config Path ---
    if [[ -z "$env_file" ]]; then
        return 1
    fi

    if [[ ! -f "$env_file" ]]; then
        return 1
    fi

    # Parse ENV file
    while IFS='=' read -r key value || [[ -n "$key" ]]; do
        [[ -z "$key" || "$key" =~ ^[[:space:]]*# ]] && continue
        key="${key#"${key%%[![:space:]]*}"}"
        key="${key%"${key##*[![:space:]]}"}"
        
        if [[ "$key" == "CFGFILE" ]]; then
            value="${value#"${value%%[![:space:]]*}"}"
            value="${value%"${value##*[![:space:]]}"}"
            value="${value#\"}"; value="${value%\"}"
            value="${value#\'}"; value="${value%\'}"
            found_config_path="$value"
            break
        fi
    done < "$env_file"

    if [[ -z "$found_config_path" ]] || [[ ! -f "$found_config_path" ]]; then
        return 1
    fi

    # --- STEP 2: Resolve EVENT_HANDLER ---
    while IFS='=' read -r key value || [[ -n "$key" ]]; do
        [[ -z "$key" || "$key" =~ ^[[:space:]]*# ]] && continue
        key="${key#"${key%%[![:space:]]*}"}"
        key="${key%"${key##*[![:space:]]}"}"
        
        if [[ "$key" == "EVENT_HANDLER" ]]; then
            value="${value#"${value%%[![:space:]]*}"}"
            value="${value%"${value##*[![:space:]]}"}"
            value="${value#\"}"; value="${value%\"}"
            value="${value#\'}"; value="${value%\'}"
            found_handler_path="$value"
            break
        fi
    done < "$found_config_path"

    # --- STEP 3: Set GLOBAL Variables (Force Global) ---
    # We use 'declare -g' to ensure these are global even if the function is sourced in a weird way
    declare -g RESOLVED_CONFIG_FILE="$found_config_path"
    declare -g RESOLVED_CONFIG_DIR="$(dirname "$found_config_path")"
    
    if [[ -n "$found_handler_path" ]]; then
        declare -g RESOLVED_EVENT_HANDLER_DIR="$(dirname "$found_handler_path")"
    else
        # Explicitly set to empty string if not found, so we know it was checked
        declare -g RESOLVED_EVENT_HANDLER_DIR=""
    fi

    return 0
}

# Get service status as a word: active, inactive, failed, unknown
get_service_status() {
    local st
    st=$(systemctl is-active "${1}.service" 2>/dev/null) || true
    echo "${st:-unknown}"
}

# Build a status summary string for the menu title
build_status_title() {
    local title=""
    for svc in "${SERVICES[@]}"; do
        local status
        status=$(get_service_status "$svc")
        local label="${SERVICE_LABELS[$svc]}"
        if [[ "$DIALOG" == "dialog" ]]; then
            case "$status" in
                active)  title+="\Z2● ${label}\Zn  " ;;
                failed)  title+="\Z1● ${label}\Zn  " ;;
                *)       title+="\Z3○ ${label}\Zn  " ;;
            esac
        else
            case "$status" in
                active)  title+="[UP] ${label}  " ;;
                failed)  title+="[FAIL] ${label}  " ;;
                *)       title+="[DOWN] ${label}  " ;;
            esac
        fi
    done

    echo "$title"
}

# Build system info string for the title bar
build_sysinfo() {
    local info=""

    # CPU temperature
    local temp_file="/sys/class/thermal/thermal_zone0/temp"
    if [[ -r "$temp_file" ]]; then
        local raw
        raw=$(<"$temp_file")
        info+="${temp_file:+$((raw / 1000))°C}"
    fi

    # Uptime
    local up
    up=$(uptime -p 2>/dev/null | sed 's/up //;s/ days\?/d/;s/ hours\?/h/;s/ minutes\?/m/;s/,//g') || true
    [[ -n "$up" ]] && info+="  Up ${up}"

    # Last boot
    local last_boot
    last_boot=$(uptime -s 2>/dev/null) || true
    [[ -n "$last_boot" ]] && info+="  Since ${last_boot%:*}"

    echo "$info"
}

# =============================================================================
# Service Picker
# =============================================================================

# Sets PICKED_SERVICE to the chosen service name, or returns 1 on cancel.
PICKED_SERVICE=""
pick_service() {
    PICKED_SERVICE=""
    local prompt="${1:-Select a service:}"
    local items=()
    local i=1
    for svc in "${SERVICES[@]}"; do
        local status
        status=$(get_service_status "$svc")
        items+=("$i" "$(printf "%-14s(%s)" "${SERVICE_LABELS[$svc]}" "$status")")
        ((i++))
    done

    if [[ "$DIALOG" == "dialog" ]]; then
        dialog --colors --no-shadow --title " Select Service " \
            --menu "\n$prompt\n" 14 0 3 \
            "${items[@]}" 2>"$DIALOG_OUT" || return 1
    fi

    local choice
    choice=$(<"$DIALOG_OUT")
    PICKED_SERVICE="${SERVICES[$((choice - 1))]}"
    [[ -n "$PICKED_SERVICE" ]] || return 1
}

# =============================================================================
# Result Display
# =============================================================================

show_result() {
    local title="$1"
    local msg="$2"
    if [[ "$DIALOG" == "dialog" ]]; then
        dialog --colors --no-shadow --title "$title" --msgbox "$msg" 15 60
    fi
}

# =============================================================================
# Service Control Actions
# =============================================================================

do_service_action() {
    local action="$1"
    pick_service "Select service to ${action}:" || return
    local svc="$PICKED_SERVICE"
    local output
    output=$(sudo systemctl "$action" "${svc}.service" 2>&1) && \
        show_result "Success" "${SERVICE_LABELS[$svc]}: ${action} completed.\n\n${output}" || \
        show_result "Error" "${SERVICE_LABELS[$svc]}: ${action} failed.\n\n${output}"
}

action_start()   { do_service_action "start"; }
action_stop()    { do_service_action "stop"; }
action_restart() { do_service_action "restart"; }
action_reload()  { do_service_action "reload"; }
action_enable()  { do_service_action "enable"; }
action_disable() { do_service_action "disable"; }

# =============================================================================
# Monitoring Actions
# =============================================================================

action_status() {
    pick_service "Show status for:" || return
    local svc="$PICKED_SERVICE"
    local output
    output=$(systemctl status "${svc}.service" 2>&1 || true)
    show_result "${SERVICE_LABELS[$svc]} Status" "$output"
}

# =============================================================================
# NEW FUNCTION: View Log File (Tailbox - Scrollable & Live)
# =============================================================================

action_logs() {
    pick_service "Select service to view logs for:" || return
    local svc="$PICKED_SERVICE"
    local logfile; logfile=$(resolve_logfile "$svc")
    # Check if the log file exists
    if [[ ! -f "$logfile" ]]; then
        show_result "No Log File" "Log file not found:\n${logfile}\n\nThe service might be logging to journald only."
         clear
        echo "=== Following logs for ${SERVICE_LABELS[$svc]} (Ctrl+C to return) ==="
        echo ""
        (
        trap 'exit 0' INT
        journalctl -u "${svc}.service" -f
        )
        return
    fi

    # Check file size to prevent freezing on huge files
    local max_size_mb=50
    local file_size_kb
    file_size_kb=$(du -k "$logfile" | cut -f1)
    local file_size_mb=$((file_size_kb / 1024))

    if [[ $file_size_mb -gt $max_size_mb ]]; then
        if [[ "$DIALOG" == "dialog" ]]; then
            dialog --colors --no-shadow --title "File Too Large" \
                --msgbox "The log file is too large (${file_size_mb}MB).\n\nUsing tailbox on large files may be slow.\n\nRecommend using SSH or 'Follow live logs'." 12 60
        else
            whiptail --title "File Too Large" \
                --msgbox "The log file is too large (${file_size_mb}MB).\n\nUsing tailbox on large files may be slow.\n\nRecommend using SSH or 'Follow live logs'." 12 60
        fi
        return
    fi

    # Display the log file in a tailbox (scrollable + live follow)
    if [[ "$DIALOG" == "dialog" ]]; then
        # Note: --tailbox requires the file to exist and be readable
        dialog --colors --no-shadow --title " Log: ${logfile##*/} " \
            --tailbox "$logfile" 40 100
    fi
}

