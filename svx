        return
    fi

    # Extract all RepeaterLogic and SimplexLogic section names with their RX values
    local logics=()
    local current_section=""
    local current_rx=""

    while IFS= read -r line; do
        # Check if this is a RepeaterLogic or SimplexLogic section header
        if [[ "$line" =~ ^\[(RepeaterLogic|SimplexLogic)[^]]*\] ]]; then
            # Save previous section if it has RX
            if [[ -n "$current_section" && -n "$current_rx" ]]; then
                logics+=("$current_section|$current_rx")
            fi
            # Start new section
            current_section="${BASH_REMATCH[0]}"
            current_section="${current_section%]}"
            current_section="${current_section#[}"
            current_rx=""
        # Extract RX value
        elif [[ "$line" =~ ^RX= ]]; then
            current_rx="${line#RX=}"
            current_rx="${current_rx// /}"  # Remove spaces
        fi
    done < "$conf"

    # Don't forget the last section
    if [[ -n "$current_section" && -n "$current_rx" ]]; then
