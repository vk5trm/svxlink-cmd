action_list_voices() {
    # 1. Check if git is available
    if ! command -v git &>/dev/null; then
        show_result "Error" "git is not installed.\n\nInstall it with:\n  sudo apt install git"
        return 1
    fi

    # 2. Resolve Config
    if ! resolve_config_from_env; then
        dialog --title "Config Error" --msgbox "Failed to resolve config." 12 60
        return 1
    fi

    # 3. SAFETY CHECK: Verify the variable was actually set
    if [[ -z "$RESOLVED_EVENT_HANDLER_DIR" ]]; then
        if [[ -n "$RESOLVED_CONFIG_FILE" ]]; then
            local direct_handler
            direct_handler=$(grep -E "^EVENT_HANDLER=" "$RESOLVED_CONFIG_FILE" | head -1 | cut -d'=' -f2- | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | sed "s/^['\"]//;s/['\"]$//")
            
            if [[ -n "$direct_handler" ]]; then
                RESOLVED_EVENT_HANDLER_DIR="$(dirname "$direct_handler")"
            else
                dialog --title "Missing Config" --msgbox "Could not find 'EVENT_HANDLER' in:\n$RESOLVED_CONFIG_FILE" 16 60
                return 1
            fi
        else
            dialog --title "Critical Error" --msgbox "Config file path is unknown." 12 60
            return 1
        fi
    fi

    # 4. Determine the actual Sound Directory
    local EVENTS_DIR="$RESOLVED_EVENT_HANDLER_DIR"
    local SOUND_DIR=""

    # Check if 'sounds' is a subdirectory
    if [[ -d "$EVENTS_DIR/sounds" ]]; then
        SOUND_DIR="$EVENTS_DIR/sounds"
    else
        # Fallback: Check if base dir exists
        if [[ ! -d "$EVENTS_DIR" ]]; then
            dialog --title "Directory Missing" --msgbox "The directory derived from EVENT_HANDLER does not exist:\n$EVENTS_DIR" 12 60
            return 1
        fi
        
        # If base exists but no 'sounds' subfolder, fail strictly
        dialog --title "Directory Missing" --msgbox "Required 'sounds' directory not found inside:\n$EVENTS_DIR\n\nPlease create it or move your files there." 12 60
        return 1
    fi

    # Verify final target
    if [[ ! -d "$SOUND_DIR" ]]; then
        show_result "Error" "Sounds directory not found:\n${SOUND_DIR}"
        return 1
    fi  

    # 5. Collect Directories (Voices)
    local -a DIRS=()
    while IFS= read -r -d '' dir; do
        DIRS+=("$dir")
    done < <(find "$SOUND_DIR" -maxdepth 1 -mindepth 1 -type d -print0 | sort -z)

    if [[ ${#DIRS[@]} -eq 0 ]]; then
        show_result "No Directories" "No voice directories found in:\n${SOUND_DIR}"
        return 1
    fi

    # 6. Build Menu Items for Directories
    local -a menu_items=()
    local idx=1
    for dir in "${DIRS[@]}"; do
        menu_items+=("$idx" "$(basename "$dir")")
        ((idx++))
    done

    # 7. Execute Directory Selection Menu
    local DIALOG_OUT
    DIALOG_OUT=$(mktemp)
    trap 'rm -f "$DIALOG_OUT"' EXIT

    local selected_dir=""
    if [[ "$DIALOG" == "dialog" ]]; then
        # Use array construction for safety
        local dialog_cmd=(dialog --colors --no-shadow --title " Select Voice Directory " --menu '\nChoose a voice repository:' 16 70 7)
        for ((i=0; i<${#menu_items[@]}; i+=2)); do
            dialog_cmd+=("${menu_items[$i]}" "${menu_items[$((i+1))]}")
        done
        
        if ! "${dialog_cmd[@]}" 2>"$DIALOG_OUT"; then
            return 0 # User cancelled
        fi
        
        local choice
        choice=$(<"$DIALOG_OUT")
        
        if [[ -z "$choice" ]] || ! [[ "$choice" =~ ^[0-9]+$ ]]; then
            return 0
        fi

        selected_dir="${DIRS[$((choice - 1))]}"
    else
        dialog --msgbox "Error: 'dialog' utility not found." 10 50
        return 1
    fi

    if [[ ! -d "$selected_dir" ]]; then
        show_result "Error" "Directory not found:\n${selected_dir}"
        return 1
    fi

    # 8. Get list of branches (voices) from the selected directory
    local -a voices=()
    local default_branch=""
    
    # Check if it's a git repo
    if [[ ! -d "$selected_dir/.git" ]]; then
        # If not a git repo, treat the whole dir as the voice
        # Create symlink if needed
        local lnk="$SOUND_DIR/en_US"
        if [[ -L "$lnk" ]]; then
            sudo rm "$lnk"
        fi
        sudo ln -sf "$selected_dir" "$lnk"
        show_result "Success" "Linked non-git directory to:\n$lnk"
        return 0
    fi

    while IFS= read -r branch; do
        branch="${branch#refs/heads/}"
        if [[ "$branch" == "main" || "$branch" == "master" ]]; then
            default_branch="$branch"
            continue
        fi
        voices+=("$branch")
    done < <(git --git-dir="$selected_dir/.git" for-each-ref refs/heads/ --format='%(refname)' 2>/dev/null)

    # Handle case with NO branches (just a default or non-git folder inside)
    if [[ ${#voices[@]} -eq 0 ]]; then
        if [[ -n "$default_branch" ]]; then
            # Auto-switch to default
            action_switch_voice "$default_branch" "$selected_dir"
            return 0
        else
            # No branches at all? Maybe it's just a raw directory with files?
            local lnk="$SOUND_DIR/en_US"
            sudo rm -f "$lnk"
            sudo ln -sf "$selected_dir" "$lnk"
            show_result "Linked" "Directory linked to:\n$lnk\n(No git branches found)"
            return 0
        fi
    fi

    # 9. Build Menu Items for Voices
    local -a voice_menu_items=()
    local v_idx=1
    for voice in "${voices[@]}"; do
        voice_menu_items+=("$v_idx" "$voice")
        ((v_idx++))
    done

    # 10. Display Voices Menu
    local v_choice=""
    if [[ "$DIALOG" == "dialog" ]]; then
        local voice_cmd=(dialog --colors --no-shadow --title " Available Voices " --menu '\nSelect a voice to checkout:' 16 70 7)
        for ((i=0; i<${#voice_menu_items[@]}; i+=2)); do
            voice_cmd+=("${voice_menu_items[$i]}" "${voice_menu_items[$((i+1))]}")
        done
        
        if ! "${voice_cmd[@]}" 2>"$DIALOG_OUT"; then
            return 0
        fi
        v_choice=$(<"$DIALOG_OUT")
    else
        dialog --msgbox "Error: 'dialog' utility not found." 10 50
        return 1
    fi

    if [[ -z "$v_choice" ]] || ! [[ "$v_choice" =~ ^[0-9]+$ ]]; then
        return 0
    fi

    local selected_voice="${voices[$((v_choice - 1))]}"

    # 11. Switch Voice
    if [[ -n "$selected_voice" ]]; then
        action_switch_voice "$selected_voice" "$selected_dir"
    fi
    
    # Cleanup trap
    rm -f "$DIALOG_OUT"
    trap - EXIT
}

action_switch_voice() {
    local voice_name="${1:-}"
    local target_repo="${2:-}" # Pass the repo path explicitly

    if [[ -z "$voice_name" ]]; then
        show_result "Error" "No voice specified."
        return 1
    fi

    # Check if git is available
    if ! command -v git &>/dev/null; then
        show_result "Error" "git is not installed."
        return 1
    fi

    # Check if target_repo is valid
    if [[ -z "$target_repo" ]] || [[ ! -d "$target_repo" ]]; then
        show_result "Error" "Invalid repository path: $target_repo"
        return 1
    fi

    # Perform git checkout and capture output
    local checkout_output
    local lnk="$SOUND_DIR/en_US"

    # We use --git-dir and --work-tree to be safe
    if checkout_output=$(git --git-dir="$target_repo/.git" --work-tree="$target_repo" checkout "$voice_name" 2>&1); then
        # Success: Remove old link and create new one
        sudo rm -rf "$lnk"
        sudo ln -sf "$target_repo" "$lnk"

        # Show success message in dialog
        if [[ "$DIALOG" == "dialog" ]]; then
            dialog --colors --no-shadow --title " Switch Voice Success " \
                --msgbox "Successfully switched to voice: $voice_name\n\nGit Output:\n$checkout_output" 15 60
        fi
    else
        # Failure: Show error in dialog
        if [[ "$DIALOG" == "dialog" ]]; then
            dialog --colors --no-shadow --title " Switch Voice Failed " \
                --msgbox "Failed to switch to voice: $voice_name\n\nError Git Output:\n$checkout_output" 15 60
        fi
    fi
}

