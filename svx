# =============================================================================
# NEW FUNCTION: Edit Event Script Actions added by VK5TRM
# =============================================================================

action_edit_events() {
    if [[ ! -d "$EVENTS_DIR" ]]; then
        show_result "Error" "Events directory not found:\n${EVENTS_DIR}"
        return
    fi

# Build final file list
# Local overrides take precedence over main files

local -a tcl_files=()
local -A seen_files=()

# Add local files first
if [[ -d "$LOCAL_EVENTS_DIR" ]]; then
    while IFS= read -r -d '' file; do
        local base
        base=$(basename "$file")

        tcl_files+=("$file")
        seen_files["$base"]=1
    done < <(
        find "$LOCAL_EVENTS_DIR" \
            -maxdepth 1 \
            -type f \
            -name "*.tcl" \
            -print0 | sort -z
    )
fi

# Add main files only if not overridden locally
while IFS= read -r -d '' file; do
    local base
    base=$(basename "$file")

    if [[ -z "${seen_files[$base]:-}" ]]; then
        tcl_files+=("$file")
    fi
done < <(
    find "$EVENTS_DIR" \
        -maxdepth 1 \
        -type f \
        -name "*.tcl" \
        -print0 | sort -z
)

    if [[ ${#tcl_files[@]} -eq 0 ]]; then
        show_result "No TCL Files" "No .tcl files found in:\n${EVENTS_DIR}"
        return
    fi

    # Build menu items as simple tag-description pairs
    local -a menu_items=()
    local idx=1
    for file in "${tcl_files[@]}"; do
        local display_name
        display_name=$(basename "$file")
        # Indicate if it's a modified override
        if [[ "$file" == "$LOCAL_EVENTS_DIR"/* ]]; then
            display_name="${display_name} (modified)"
        fi
        menu_items+=("$idx" "$display_name")
        ((idx++))
    done

    # Display menu using eval for proper expansion
    local cmd
    if [[ "$DIALOG" == "dialog" ]]; then
        cmd="dialog --colors --no-shadow --title ' Select Event Script ' --menu '\nChoose a .tcl file to edit:\n' 16 70 7"
    else
        cmd="whiptail --title ' Select Event Script ' --menu '\nChoose a .tcl file to edit:\n' 16 70 7"
    fi
    
    cmd="$cmd $(printf '%q ' "${menu_items[@]}") 2>'$DIALOG_OUT'"
    eval "$cmd" || return

    local choice
    choice=$(<"$DIALOG_OUT")
    
    if [[ -z "$choice" ]] || [[ ! "$choice" =~ ^[0-9]+$ ]]; then
        return
    fi

    local selected_file="${tcl_files[$((choice - 1))]}"

    if [[ ! -f "$selected_file" ]]; then
        show_result "Error" "File not found:\n${selected_file}"
        return
    fi

    # Check if local dir exists, create if not
    if [[ ! -d "$LOCAL_EVENTS_DIR" ]]; then
        mkdir -p "$LOCAL_EVENTS_DIR" || {
            show_result "Error" "Failed to create local events directory:\n${LOCAL_EVENTS_DIR}"
            return
        }
    fi

# Edit selected file using a temporary copy,
# then optionally save with a different filename

local original_filename
original_filename=$(basename "$selected_file")

# Create temp file
local temp_file
temp_file=$(mktemp "/run/${original_filename}.XXXXXX") || {
    show_result "Error" "Failed to create temporary file"
    return
}

# Cleanup temp file automatically
trap 'rm -f "$temp_file"' RETURN

# Copy source into temp file
if ! cp "$selected_file" "$temp_file"; then
    show_result "Error" "Failed to prepare temporary file"
    return
fi

# Edit temp file
"$EDITOR" "$temp_file"

# Detect no changes
if cmp -s "$selected_file" "$temp_file"; then
    show_result "No Changes" "File was not modified."
    return
fi

# Ask for save filename
local save_name

if [[ "$DIALOG" == "dialog" ]]; then
    save_name=$(dialog \
        --stdout \
        --title " Save Event Script " \
        --inputbox "\nSave as filename:" \
        10 60 \
        "$original_filename")
else
    save_name=$(whiptail \
        --inputbox "\nSave as filename:" \
        10 60 \
        "$original_filename" \
        3>&1 1>&2 2>&3)
fi

# Cancelled
[[ $? -eq 0 ]] || return

# Empty filename
if [[ -z "$save_name" ]]; then
    show_result "Error" "Filename cannot be empty."
    return
fi

# Ensure .tcl extension
[[ "$save_name" != *.tcl ]] && save_name="${save_name}.tcl"

# Ensure local dir exists
mkdir -p "$LOCAL_EVENTS_DIR" || {
    show_result "Error" \
        "Failed to create local events directory:\n${LOCAL_EVENTS_DIR}"
    return
}

local local_file="${LOCAL_EVENTS_DIR}/${save_name}"

# Save edited version
if ! cp "$temp_file" "$local_file"; then
    show_result "Error" \
        "Failed to save edited file to:\n${local_file}"
    return
fi
}
# =============================================================================
# GPIO Action
