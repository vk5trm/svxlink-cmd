    fi
    
    # Create menu items from logics
    local items=()
    local i=1
    for logic in "${logics[@]}"; do
        local section="${logic%%|*}"
        local rx="${logic##*|}"
        items+=("$i" "$section - RX: $rx")
        ((i++))
    done
    
    if [[ "$DIALOG" == "dialog" ]]; then
        dialog --colors --no-shadow --title " Select RX " \
            --menu "\nChoose an RX section:\n" 16 70 "${#items[@]}" \
            "${items[@]}" 2>"$DIALOG_OUT" || return
    else
        whiptail --title " Select RX " \
            --menu "\nChoose an RX section:\n" 16 70 "${#items[@]}" \
            "${items[@]}" 2>"$DIALOG_OUT" || return
    fi
    
    local choice
    choice=$(<"$DIALOG_OUT")
    local selected_logic="${logics[$((choice - 1))]}"
    
    # Parse the selected logic to get RX section
    local rx_section="${selected_logic##*|}"
    
    # Stop svxlink service
    clear
    echo "=== Stopping svxlink service ==="
    systemctl stop svxlink.service
    sleep 2
    
    # Run siglevdetcal
    echo "=== Running siglevdetcal $conf $rx_section (Ctrl+C to stop) ==="
    echo ""
    (
        trap 'exit 0' INT
        siglevdetcal "$conf" "$rx_section"
    )
    
    # Restart svxlink service
    echo ""
    echo "=== Restarting svxlink service ==="
    systemctl start svxlink.service
    sleep 2
    
    echo "Done! Press Enter to return to menu..."
    read -r
}
action_reboot() {
 # Restart Computer
    clear
    echo "=== Restarting Computer ==="
    reboot -n
    sleep 2
}
