action_alsamixer() {
    local usb_card=""
    if [[ -f /proc/asound/cards ]]; then
        usb_card=$(awk '/USB-Audio/{print $1; exit}' /proc/asound/cards)
    fi
    if [[ -n "$usb_card" ]]; then
        alsamixer -c "$usb_card" || true
    else
        alsamixer || true
    fi
}

readonly LOGROTATE_CONF="/etc/logrotate.d/svxlink-server"
readonly LOGROTATE_CONTENT='
/var/log/svxlink
/var/log/remotetrx
/var/log/svxreflector
{
    daily
    rotate 7
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
}'

action_check_logrotate() {
    # Check if any file-based logs exist
    local has_logs=false
    for svc in "${SERVICES[@]}"; do
        [[ -f "${LOG_FILES[$svc]}" ]] && has_logs=true && break
    done

    if [[ "$has_logs" == false ]]; then
        show_result "No File Logs" "No SvxLink file-based logs found.\n\nServices are logging to journald only.\nNo log rotation needed."
        return
    fi

    # File logs exist — check logrotate
    if ! command -v logrotate &>/dev/null; then
        show_result "Warning" "SvxLink is writing to log files but\nlogrotate is not installed.\n\nInstall it with:\n  apt install logrotate\n\nThen run this check again."
        return
    fi

    if [[ -f "$LOGROTATE_CONF" ]]; then
        local content
        content=$(<"$LOGROTATE_CONF")
        show_result "Log Rotation OK" "Config: ${LOGROTATE_CONF}\n\n${content}"
    else
        if [[ "$DIALOG" == "dialog" ]]; then
            dialog --colors --no-shadow --title " Log Rotation Missing " \
                --yesno "\nSvxLink is writing to log files but no\nlogrotate config was found.\n\nCreate ${LOGROTATE_CONF}?\n\nDaily rotation, 7 copies, compressed.\n" 15 55 2>"$DIALOG_OUT"
        else
            whiptail --title " Log Rotation Missing " \
                --yesno "\nSvxLink is writing to log files but no\nlogrotate config was found.\n\nCreate ${LOGROTATE_CONF}?\n\nDaily rotation, 7 copies, compressed.\n" 15 55 2>"$DIALOG_OUT"
        fi
        if [[ $? -eq 0 ]]; then
            echo "$LOGROTATE_CONTENT" > "$LOGROTATE_CONF"
            chmod 644 "$LOGROTATE_CONF"
            show_result "Success" "Created ${LOGROTATE_CONF}\n\nLog rotation is now active."
        fi
    fi
}

action_health_check() {
    local report=""

    # Disk usage
    report+="DISK USAGE\n"
    report+="$(df -h --output=target,size,used,avail,pcent / /boot 2>/dev/null | head -5)\n"
    report+="\n"

    # Top 10 CPU consuming processes
    report+="TOP 10 PROCESSES (CPU)\n"
    report+="$(ps -eo pid,user,%cpu,%mem,comm --sort=-%cpu | head -11)\n"

    if [[ "$DIALOG" == "dialog" ]]; then
        dialog --colors --no-shadow --title " System Health " \
            --msgbox "$report" 28 70
    else
        whiptail --title " System Health " \
            --msgbox "$report" 28 70
    fi
}

# =============================================================================
# NEW FUNCTION: devcal with Section Selection added by VK5TRM
# =============================================================================

action_devcal_sections() {
    local conf="${CONFIG_FILES[svxlink]}"
    
    if [[ ! -f "$conf" ]]; then
        show_result "Error" "Config file not found:\n${conf}"
        return
    fi
    
    # Extract all RepeaterLogic and SimplexLogic section names with their RX and TX values
    local logics=()
    local current_section=""
    local current_rx=""
    local current_tx=""
    
    while IFS= read -r line; do
        # Check if this is a RepeaterLogic or SimplexLogic section header
        if [[ "$line" =~ ^\[(RepeaterLogic|SimplexLogic)[^]]*\] ]]; then
            # Save previous section if it has RX and TX
            if [[ -n "$current_section" && -n "$current_rx" && -n "$current_tx" ]]; then
                logics+=("$current_section|$current_rx|$current_tx")
            fi
            # Start new section
            current_section="${BASH_REMATCH[0]}"
            current_section="${current_section%]}"
            current_section="${current_section#[}"
            current_rx=""
            current_tx=""
        # Extract RX value
        elif [[ "$line" =~ ^RX= ]]; then
            current_rx="${line#RX=}"
            current_rx="${current_rx// /}"  # Remove spaces
        # Extract TX value
        elif [[ "$line" =~ ^TX= ]]; then
            current_tx="${line#TX=}"
            current_tx="${current_tx// /}"  # Remove spaces
        fi
    done < "$conf"
    
    # Don't forget the last section
    if [[ -n "$current_section" && -n "$current_rx" && -n "$current_tx" ]]; then
        logics+=("$current_section|$current_rx|$current_tx")
    fi
    
    if [[ ${#logics[@]} -eq 0 ]]; then
        show_result "No Logics Found" "No RepeaterLogic or SimplexLogic sections found in:\n${conf}"
        return
    fi
    
    # Create menu items from logics
    local items=()
    local i=1
    for logic in "${logics[@]}"; do
        local section="${logic%%|*}"
        local rx="${logic#*|}"
        rx="${rx%%|*}"
        local tx="${logic##*|}"
        items+=("$i" "$section (RX: $rx / TX: $tx)")
        ((i++))
    done
    
    if [[ "$DIALOG" == "dialog" ]]; then
        dialog --colors --no-shadow --title " Select Logic " \
            --menu "\nChoose a logic section:\n" 16 70 "${#items[@]}" \
            "${items[@]}" 2>"$DIALOG_OUT" || return
    else
        whiptail --title " Select Logic " \
            --menu "\nChoose a logic section:\n" 16 70 "${#items[@]}" \
            "${items[@]}" 2>"$DIALOG_OUT" || return
    fi
    
    local choice
    choice=$(<"$DIALOG_OUT")
    local selected_logic="${logics[$((choice - 1))]}"
    
    # Parse the selected logic using pipe delimiter
    local rx_section="${selected_logic#*|}"
    rx_section="${rx_section%%|*}"
    local tx_section="${selected_logic##*|}"
    
    # Show RX/TX selection menu
    local rxtx_items=(
        "1" "RX: $rx_section"
        "2" "TX: $tx_section"
    )
    
    if [[ "$DIALOG" == "dialog" ]]; then
        dialog --colors --no-shadow --title " Select RX or TX " \
            --menu "\nChoose which to calibrate:\n" 12 40 2 \
            "${rxtx_items[@]}" 2>"$DIALOG_OUT" || return
    else
        whiptail --title " Select RX or TX " \
            --menu "\nChoose which to calibrate:\n" 12 40 2 \
            "${rxtx_items[@]}" 2>"$DIALOG_OUT" || return
    fi
    
    local rxtx_choice
    rxtx_choice=$(<"$DIALOG_OUT")
    
    # Determine which section and flag to use
    local section
    local flag
    if [[ "$rxtx_choice" == "1" ]]; then
        section="$rx_section"
        flag="-r"
    else
        section="$tx_section"
        flag="-t"
    fi
    
    # Stop svxlink service
    clear
    echo "=== Stopping svxlink service ==="
    systemctl stop svxlink.service
    sleep 2
    
    # Run devcal
    echo "=== Running devcal ${flag} ${section} (Ctrl+C to stop) ==="
    echo ""
    (
        trap 'exit 0' INT
        devcal ${flag} "$conf" "$section"
    )
    
    # Restart svxlink service
    echo ""
    echo "=== Restarting svxlink service ==="
    systemctl start svxlink.service
    sleep 2
    
    echo "Done! Press Enter to return to menu..."
    read -r
}

