    if [[ ! "$choice" =~ ^[0-9]+$ ]] || (( choice < 1 || choice > ${#logics[@]} )); then
        dialog --title "Error" --msgbox "Invalid selection." 8 60
        return 1
    fi

    local selected_logic="${logics[$((choice - 1))]}"
    local selected_section="${selected_logic%%|*}"
    local selected_rx="${selected_logic##*|}"

    # 5. Stop Service
    if [[ $(systemctl is-active svxlink.service) == "active" ]]; then
        clear
        echo "Stopping svxlink..."
        sudo systemctl stop svxlink.service
        sleep 2
    fi

    # 6. Run Calibration
    clear
    echo "=== Running siglevdetcal ==="
    echo "Config: $conf"
    echo "RX Section: $selected_rx"
    echo "(Press Ctrl+C to stop)"
    echo ""

    (
        trap 'exit 0' INT
        siglevdetcal "$conf" "$selected_rx"
    )

    dialog --title "Complete" --msgbox "Calibration done!\nRestart svxlink from main menu." 8 60
}

# =============================================================================
# FUNCTION: Send DTMF (Forced Auto-Discover)
# =============================================================================
action_dtmf_control() {
    local target_pty=""
    local real_pty=""
    local target_name=""
    local -a valid_links=()
    local -a link_targets=()

    # 1. SCAN: Find ALL valid symlinks in /tmp and /dev/shm
    while IFS= read -r -d '' link_path; do
        # Check if it is actually a symlink
        if [[ -L "$link_path" ]]; then
            # Resolve the target
            local resolved_target
            resolved_target=$(readlink -f "$link_path" 2>/dev/null)
            
            # Check if the target actually exists (is not a broken link)
            if [[ -n "$resolved_target" && -e "$resolved_target" ]]; then
                valid_links+=("$link_path")
                link_targets+=("$resolved_target")
            fi
        fi
    done < <(find /tmp /dev/shm -maxdepth 1 -name "*dtmf*" -type l -print0 2>/dev/null)

    # 2. HANDLE MULTIPLE OR SINGLE FINDINGS
    local num_found=${#valid_links[@]}

    if [[ $num_found -eq 0 ]]; then
        # --- CASE: No links found ---
        if [[ "$DIALOG" == "dialog" ]]; then
            target_pty=$(dialog --stdout --title " Manual PTY Path " \
                --inputbox "\nNo valid PTY found automatically.\n\nEnter path manually:" \
                12 60 "/tmp/dtmf_ctrl" 2>"$DIALOG_OUT")
        else
            read -rp "Enter PTY path manually: " target_pty
            target_pty="${target_pty:-/tmp/dtmf_ctrl}"
        fi

        if [[ -z "$target_pty" ]]; then
            show_result "Error" "No path provided."
            return
        fi

        # Verify manually entered path
        if [[ ! -e "$target_pty" ]]; then
            show_result "Error" "Path not found: $target_pty"
            return
        fi

        real_pty=$(readlink -f "$target_pty" 2>/dev/null)
        if [[ -z "$real_pty" || ! -e "$real_pty" ]]; then
            real_pty="$target_pty"
        fi

    elif [[ $num_found -eq 1 ]]; then
        # --- CASE: Exactly one link found (Auto-select) ---
        target_pty="${valid_links}"
        real_pty="${link_targets}"
        target_name="Auto-Found: $target_pty"

    else
        # --- CASE: Multiple links found (User Selection) ---
        local -a menu_items=()
        local idx=1

        for i in "${!valid_links[@]}"; do
            local link="${valid_links[$i]}"
            local tgt="${link_targets[$i]}"
            # Format: "1" "/tmp/dtmf_ctrl"
            menu_items+=("$idx" "$link")
            ((idx++))
        done

        if [[ "$DIALOG" == "dialog" ]]; then
            dialog --colors --no-shadow --title " Select PTY Device " \
                --menu "\nMultiple DTMF devices found.\nChoose the correct one:" \
                16 70 ${#menu_items[@]} 2>"$DIALOG_OUT" "${menu_items[@]}" || return
        fi

        local choice
        choice=$(<"$DIALOG_OUT")

        if [[ -z "$choice" ]] || [[ ! "$choice" =~ ^[0-9]+$ ]]; then
            return # User cancelled
        fi

        # Convert 1-based choice to 0-based array index
        local idx=$((choice - 1))
        target_pty="${valid_links[$idx]}"
        real_pty="${link_targets[$idx]}"
        target_name="User Selected: $target_pty"
    fi

    # 3. Ask for DTMF command
    local target_cmd="1#"
    if [[ "$DIALOG" == "dialog" ]]; then
        target_cmd=$(dialog --stdout --title " Send DTMF " --inputbox "\nEnter DTMF - (No # required)" 10 50 "*" 2>"$DIALOG_OUT")
    else
        read -rp "Enter DTMF - (No # required): " target_cmd
        target_cmd="${target_cmd:-*}"
    fi

    [[ -z "$target_cmd" ]] && return

    # 4. Send the command
    if [[ "$DIALOG" == "dialog" ]]; then
        dialog --colors --no-shadow --title " Sending DTMF " \
            --infobox "\nSending: $target_cmd\n" 6 60
    fi

    # Use sudo sh -c with printf to handle special characters safely
    if sudo sh -c "printf '%s' '${target_cmd}#' > '${real_pty}'" 2>/dev/null; then
        if [[ "$DIALOG" == "dialog" ]]; then
            dialog --colors --no-shadow --title " Success " \
                --msgbox "Command sent successfully!\n\nCommand: $target_cmd" 12 60
        else
            echo "Command sent successfully!\n\nCommand: $target_cmd"
        fi
    else
        local err_msg
        err_msg=$(sudo sh -c "printf '%s' '${target_cmd}' > '${real_pty}'" 2>&1)
        show_result "Error" "Failed to write to device:\n\nError: $err_msg\n\nCheck if SvxLink is running."
    fi
}

