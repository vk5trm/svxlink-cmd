action_devcal_sections() {
    local conf="${CONFIG_FILES[svxlink]}"

    if [[ ! -f "$conf" ]]; then
        show_result "Error" "Config file not found:\n${conf}"
        return
    fi

    # Extract all RepeaterLogic and SimplexLogic section names with their RX and TX values
    local logics=()
    local current_section=""
    local current_rx=""
    local current_tx=""

    while IFS= read -r line; do
        # Check if this is a RepeaterLogic or SimplexLogic section header
        if [[ "$line" =~ ^\[(RepeaterLogic|SimplexLogic)[^]]*\] ]]; then
            # Save previous section if it has RX and TX
            if [[ -n "$current_section" && -n "$current_rx" && -n "$current_tx" ]]; then
                logics+=("$current_section|$current_rx|$current_tx")
            fi
            # Start new section
            current_section="${BASH_REMATCH[0]}"
            current_section="${current_section%]}"
            current_section="${current_section#[}"
            current_rx=""
            current_tx=""
        # Extract RX value
        elif [[ "$line" =~ ^RX= ]]; then
            current_rx="${line#RX=}"
            current_rx="${current_rx// /}"  # Remove spaces
        # Extract TX value
        elif [[ "$line" =~ ^TX= ]]; then
            current_tx="${line#TX=}"
            current_tx="${current_tx// /}"  # Remove spaces
        fi
    done < "$conf"

    # Don't forget the last section
    if [[ -n "$current_section" && -n "$current_rx" && -n "$current_tx" ]]; then
        logics+=("$current_section|$current_rx|$current_tx")
    fi

    if [[ ${#logics[@]} -eq 0 ]]; then
        show_result "No Logics Found" "No RepeaterLogic or SimplexLogic sections found in:\n${conf}"
        return
    fi

    # Create menu items from logics
    local items=()
    local i=1
    for logic in "${logics[@]}"; do
        local section="${logic%%|*}"
        local rx="${logic#*|}"
        rx="${rx%%|*}"
        local tx="${logic##*|}"
        items+=("$i" "$section (RX: $rx / TX: $tx)")
        ((i++))
    done

    if [[ "$DIALOG" == "dialog" ]]; then
        dialog --colors --no-shadow --title " Select Logic " \
            --menu "\nChoose a logic section:\n" 16 70 "${#items[@]}" \
            "${items[@]}" 2>"$DIALOG_OUT" || return
    fi

    local choice
    choice=$(<"$DIALOG_OUT")
    local selected_logic="${logics[$((choice - 1))]}"

    # Parse the selected logic using pipe delimiter
    local rx_section="${selected_logic#*|}"
    rx_section="${rx_section%%|*}"
    local tx_section="${selected_logic##*|}"

    # Show RX/TX selection menu
    local rxtx_items=(
        "1" "RX: $rx_section"
        "2" "TX: $tx_section"
    )

    if [[ "$DIALOG" == "dialog" ]]; then
        dialog --colors --no-shadow --title " Select RX or TX " \
            --menu "\nChoose which to calibrate:\n" 12 40 2 \
            "${rxtx_items[@]}" 2>"$DIALOG_OUT" || return
    fi

    local rxtx_choice
    rxtx_choice=$(<"$DIALOG_OUT")

    # Determine which section and flag to use
    local section
    local flag
    if [[ "$rxtx_choice" == "1" ]]; then
        section="$rx_section"
        flag="-r"
    else
        section="$tx_section"
        flag="-t"
    fi
    if [[ $(systemctl is-active svxlink.service) == "active" ]]; then
        clear
        echo "=== Stopping svxlink service ==="
        sudo systemctl stop svxlink.service
        sleep 2
    fi
    # Run devcal
    echo "=== Running devcal ${flag} ${section} (Ctrl+C to stop) ==="
    if [[ "$flag" == -r ]]; then
        echo "== Recommended setup for measurement:"
        echo " Please set a RF signal generator on the Frequency you are using at 1000 Hz tone 2400 Hz deviation "
        echo "    1. Adjust level using Alsamixer to as close as you can to 2400 Hz (coarce ajustment)"
        echo "    2. Adjust level using + or - in devcal (fine adjustment)"
        echo "    3. Put the PREAMP= dB level into your svxlink.conf RX section."
        echo "    4. This corresponds to a frequency deviation of 2404 Hz or -12 dBFS and -9 dBFS at 3500 Hz deviation."
    else
        echo "== Recommended setup for measurement:"
        echo "   - Hit T on keyboard to transmit"
        echo "   - Use a deviation meter if available OR"
        echo "   - Use the Bessel 0 Null method:"
        echo "       2. Devcal will apply a sinusoidal modulating tone of 1000 Hz."
        echo "       2. Adjust the modulation until the carrier is minimized."
        echo "       3. Use Alsamixer for coarce adjustment then + or - in devcal for fine adjustment"
        echo "       4. Put the MASTER_GAIN= dB value into your svxlink.conf TX section"
        echo "       5. This corresponds to a frequency deviation of 2404 Hz or -12 dBFS and -9 dBFS at 3500 Hz deviation."
        echo "   - If using an SSB receiver, tune to the carrier frequency -1 kHz for proper observation."
    fi
    echo ""
    (
        trap 'exit 0' INT
        devcal ${flag} "$conf" "$section"
    )

    show_result "Calibration Complete" "Don't forget to restart the svxlink service!\n\nYou can do this from the main menu."
}

