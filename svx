# NEW FUNCTION: devcal with Section Selection added by VK5TRM
# =============================================================================

action_devcal_sections() {
    # 1. Resolve Config
    if ! resolve_config_from_env; then
        dialog --title "Error" --msgbox "Failed to resolve config path." 8 60
        return 1
    fi

    local conf="$RESOLVED_CONFIG_FILE"
    local dir="$RESOLVED_CONFIG_DIR"

    if [[ ! -f "$conf" ]]; then
        dialog --title "Error" --msgbox "Config file not found:\n$conf" 8 60
        return 1
    fi

    # 2. Extract Logic Entries (RX & TX) using AWK
    # Format: Section|RX_Sections|TX_Sections
    local logics_raw
    logics_raw=$(awk '
        BEGIN { section="" }
        
        # Detect Section Header [SectionName]
        /^\[.*\]/ {
            sub(/^\[/, ""); sub(/\]$/, "")
            gsub(/^[ \t]+/, ""); gsub(/[ \t]+$/, "")
            section = $0
            next
        }

        # Process RepeaterLogic or SimplexLogic
        (section == "RepeaterLogic" || section == "SimplexLogic") {
            lower_line = tolower($0)
            
            # Extract RX
            if (lower_line ~ /^[ \t]*rx[ \t]*=/) {
                eq_pos = index($0, "=")
                if (eq_pos > 0) {
                    val = substr($0, eq_pos + 1)
                    gsub(/^[ \t"]+/, "", val)
                    gsub(/[ \t"]+$/, "", val)
                    if (val != "") rx_val = val
                }
            }
            
            # Extract TX
            if (lower_line ~ /^[ \t]*tx[ \t]*=/) {
                eq_pos = index($0, "=")
                if (eq_pos > 0) {
                    val = substr($0, eq_pos + 1)
                    gsub(/^[ \t"]+/, "", val)
                    gsub(/[ \t"]+$/, "", val)
                    if (val != "") tx_val = val
                }
            }
        }
        
        # When a new section starts or file ends, print the previous one if valid
        # We handle the "last section" by printing when we hit a new section or END
        # But simpler: print whenever we have both RX and TX at the start of a new section or END
    ' "$conf" 2>&1)

    # The above AWK logic needs a small tweak to print the results. 
    # Let's use a simpler "State Machine" approach in AWK to ensure we print correctly.
    
    logics_raw=$(awk '
        BEGIN { section=""; rx=""; tx="" }
        
        /^\[.*\]/ {
            # If we just finished a logic section, print it
            if (section == "RepeaterLogic" || section == "SimplexLogic") {
                if (rx != "" && tx != "") {
                    print section "|" rx "|" tx
                }
            }
            # Start new section
            sub(/^\[/, ""); sub(/\]$/, "")
            gsub(/^[ \t]+/, ""); gsub(/[ \t]+$/, "")
            section = $0
            rx = ""; tx = ""
            next
        }

        (section == "RepeaterLogic" || section == "SimplexLogic") {
            lower_line = tolower($0)
            if (lower_line ~ /^[ \t]*rx[ \t]*=/) {
                eq_pos = index($0, "=")
                if (eq_pos > 0) {
                    val = substr($0, eq_pos + 1)
                    gsub(/^[ \t"]+/, "", val)
                    gsub(/[ \t"]+$/, "", val)
                    rx = val
                }
            }
            if (lower_line ~ /^[ \t]*tx[ \t]*=/) {
                eq_pos = index($0, "=")
                if (eq_pos > 0) {
                    val = substr($0, eq_pos + 1)
                    gsub(/^[ \t"]+/, "", val)
                    gsub(/[ \t"]+$/, "", val)
                    tx = val
                }
            }
        }
        
        END {
            # Print the last section if valid
            if (section == "RepeaterLogic" || section == "SimplexLogic") {
                if (rx != "" && tx != "") {
                    print section "|" rx "|" tx
                }
            }
        }
    ' "$conf" 2>&1)

    # Check if found
    if [[ -z "$logics_raw" ]]; then
        dialog --title "Error" --msgbox "No RepeaterLogic or SimplexLogic sections with RX/TX found.\n\nCheck config file format." 12 60
        return 1
    fi

    # 3. Build Menu
    local logics=()
    while IFS= read -r line; do
        [[ -n "$line" ]] && logics+=("$line")
    done <<< "$logics_raw"

    local items=()
    local i=1
    for logic in "${logics[@]}"; do
        local section="${logic%%|*}"
        local rx="${logic#*|}"; rx="${rx%%|*}"
        local tx="${logic##*|}"
        items+=("$i" "$section (RX: $rx / TX: $tx)")
        ((i++))
    done

    # 4. Show Logic Selection Menu
    local choice
    dialog --colors --no-shadow --title "Select Logic" \
        --menu "\nChoose a logic section:\n" 16 70 "${#items[@]}" \
        "${items[@]}" 2>"$DIALOG_OUT" || return

    choice=$(<"$DIALOG_OUT")

    if [[ ! "$choice" =~ ^[0-9]+$ ]] || (( choice < 1 || choice > ${#logics[@]} )); then
        dialog --title "Error" --msgbox "Invalid selection." 8 60
        return 1
    fi

    local selected_logic="${logics[$((choice - 1))]}"
    local section_name="${selected_logic%%|*}"
    local rx_section="${selected_logic#*|}"; rx_section="${rx_section%%|*}"
    local tx_section="${selected_logic##*|}"

    # 5. Show RX/TX Selection Menu
    local rxtx_items=(
        "1" "RX: $rx_section"
        "2" "TX: $tx_section"
    )

    dialog --colors --no-shadow --title "Select RX or TX" \
        --menu "\nChoose which to calibrate:\n" 12 40 2 \
        "${rxtx_items[@]}" 2>"$DIALOG_OUT" || return

    local rxtx_choice
    rxtx_choice=$(<"$DIALOG_OUT")

    local section
    local flag
    if [[ "$rxtx_choice" == "1" ]]; then
        section="$rx_section"
        flag="-r"
    else
        section="$tx_section"
        flag="-t"
    fi

    # 6. Stop Service
    if [[ $(systemctl is-active svxlink.service) == "active" ]]; then
        clear
        echo "=== Stopping svxlink service ==="
        sudo systemctl stop svxlink.service
        sleep 2
    fi

    # 7. Run devcal
    clear
    echo "=== Running devcal ${flag} ${section} (Ctrl+C to stop) ==="
    
    if [[ "$flag" == "-r" ]]; then
        echo "== Recommended setup for measurement:"
        echo "   1. Set RF signal generator to your frequency with 1000 Hz tone, 2400 Hz deviation."
        echo "   2. Adjust level using Alsamixer for coarse adjustment."
        echo "   3. Use + or - in devcal for fine adjustment."
        echo "   4. Record PREAMP= dB value into svxlink.conf RX section."
        echo "   Note: -12 dBFS corresponds to 2404 Hz deviation."
    else
        echo "== Recommended setup for measurement:"
        echo "   1. Hit T on keyboard to transmit."
        echo "   2. Use a deviation meter OR Bessel 0 Null method."
        echo "   3. devcal applies 1000 Hz tone."
        echo "   4. Adjust modulation until carrier is minimized."
        echo "   5. Use Alsamixer (coarse) then + or - in devcal (fine)."
        echo "   6. Record MASTER_GAIN= dB value into svxlink.conf TX section."
        echo "   Note: SSB receivers should tune to carrier -1 kHz."
    fi
    echo ""

    (
        trap 'exit 0' INT
        # devcal [flag] [config] [section]
        devcal "$flag" "$conf" "$section"
    )

    dialog --title "Calibration Complete" --msgbox "Don't forget to restart svxlink!\n\nYou can do this from the main menu." 8 60
}

