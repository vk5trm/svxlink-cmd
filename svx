        MODULES_EVENTS_DIR="$EVENTS_DIR/modules.d"
    else
        # Fallback: If modules.d doesn't exist, check if the base dir itself contains the files
        # OR fail if the base dir doesn't exist either
        if [[ ! -d "$EVENTS_DIR" ]]; then
            dialog --title "Directory Missing" \
                   --msgbox "The directory derived from EVENT_HANDLER does not exist:\n$EVENTS_DIR\n\nAlso checked for 'modules.d' subfolder." \
                   12 60
            return 1
        fi
        
        # For now, let's error out if modules.d is missing, as per your original intent
        dialog --title "Directory Missing" \
               --msgbox "Required 'modules.d' directory not found inside:\n$EVENTS_DIR\n\nPlease create it or move your files there." \
               12 60
        return 1
    fi

    # 4. Verify the final target directory exists
    if [[ ! -d "$MODULES_EVENTS_DIR" ]]; then
        show_result "Error" "Module events directory not found:\n${MODULES_EVENTS_DIR}"
        return
    fi

    # 5. Find TCL files
    local -a tcl_files=()
    while IFS= read -r -d '' file; do
        tcl_files+=("$file")
    done < <(
        find "$MODULES_EVENTS_DIR" \
            -maxdepth 1 \
            -type f \
            -name "*.tcl" \
            -print0 | sort -z
    )

    if [[ ${#tcl_files[@]} -eq 0 ]]; then
        show_result "No TCL Files" "No .tcl files found in:\n${MODULES_EVENTS_DIR}"
        return
    fi

    # 6. Build Menu Items
    local -a menu_items=()
    local idx=1
    for file in "${tcl_files[@]}"; do
        local display_name
        display_name=$(basename "$file")
        menu_items+=("$idx" "$display_name")
        ((idx++))
    done

    # 7. Execute Dialog
    local cmd
    if [[ "$DIALOG" == "dialog" ]]; then
        # Use an array for safety instead of eval
        local dialog_cmd=(dialog --colors --no-shadow --title " Select Module TCL File " --menu '\nChoose a .tcl file to edit:\n' 16 70 7)
        for ((i=0; i<${#menu_items[@]}; i+=2)); do
            dialog_cmd+=("${menu_items[$i]}" "${menu_items[$((i+1))]}")
        done
        
        local DIALOG_OUT
        DIALOG_OUT=$(mktemp)
        trap 'rm -f "$DIALOG_OUT"' EXIT

        if ! "${dialog_cmd[@]}" 2>"$DIALOG_OUT"; then
            rm -f "$DIALOG_OUT"
            return
        fi

        local choice
        choice=$(<"$DIALOG_OUT")
        rm -f "$DIALOG_OUT"

        if [[ -z "$choice" ]] || ! [[ "$choice" =~ ^[0-9]+$ ]]; then
            return
        fi

        local selected_file="${tcl_files[$((choice - 1))]}"

        if [[ ! -f "$selected_file" ]]; then
            show_result "Error" "File not found:\n${selected_file}"
            return
        fi

        # 8. Edit the file
        # Ensure EDITOR is set
        local editor_cmd="${EDITOR:-nano}"
        sudo "$editor_cmd" "$selected_file"
    else
        dialog --msgbox "Error: 'dialog' utility not found." 10 50
        return 1
    fi
}

