# =============================================================================
# NEW FUNCTION: Edit Event Script Actions added by VK5TRM
# =============================================================================
action_edit_events() {
    # 1. Resolve Config
    if ! resolve_config_from_env; then
        dialog --title "Config Error" --msgbox "Failed to resolve config." 12 60
        return 1
    fi

    # 2. SAFETY CHECK: Verify the variable was actually set

    if [[ -z "$RESOLVED_EVENT_HANDLER_DIR" ]]; then
        echo "[ERROR] RESOLVED_EVENT_HANDLER_DIR is empty after function call!" >&2
        
        # LAST RESORT: Read directly from the config file if the variable failed
        if [[ -n "$RESOLVED_CONFIG_FILE" ]]; then
            local direct_handler
            direct_handler=$(grep -E "^EVENT_HANDLER=" "$RESOLVED_CONFIG_FILE" | head -1 | cut -d'=' -f2- | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | sed "s/^['\"]//;s/['\"]$//")
            
            if [[ -n "$direct_handler" ]]; then
                RESOLVED_EVENT_HANDLER_DIR="$(dirname "$direct_handler")"
            else
                dialog --title "Missing Config" \
                       --msgbox "Could not find 'EVENT_HANDLER' in:\n$RESOLVED_CONFIG_FILE\n\nPlease add 'EVENT_HANDLER=/path/to/script.tcl' to your config file." \
                       16 60
                return 1
            fi
        else
            dialog --title "Critical Error" --msgbox "Config file path is unknown." 12 60
            return 1
        fi
    fi

    # 3. Determine the actual Event Directory
    local EVENTS_DIR="$RESOLVED_EVENT_HANDLER_DIR"
    
    # Check if 'events.d' is a subdirectory (common pattern)
    if [[ -d "$EVENTS_DIR/events.d" ]]; then
        EVENTS_DIR="$EVENTS_DIR/events.d"
    elif [[ ! -d "$EVENTS_DIR" ]]; then
        dialog --title "Directory Missing" \
               --msgbox "The directory derived from EVENT_HANDLER does not exist:\n$RESOLVED_EVENT_HANDLER_DIR" \
               12 60
        return 1
    fi

    # 4. Proceed with file listing (Standard logic)
    if ! ls "$EVENTS_DIR"/*.tcl >/dev/null 2>&1; then
        dialog --title "No Events" --msgbox "No .tcl files in $EVENTS_DIR" 10 50
        return 1
    fi

    #  Verify .tcl files exist
    if ! ls "$EVENTS_DIR"/*.tcl >/dev/null 2>&1; then
        dialog --title "No Events Found" \
               --msgbox "No .tcl files found in the strict path:\n$EVENTS_DIR" \
               12 60
        return 1
    fi

    #  Proceed to list/edit (Same logic as before)
    local -a tcl_files=()
    local -A seen_files=()

    # Check for local overrides
    if [[ -d "$EVENTS_DIR/local" ]]; then
        while IFS= read -r -d '' file; do
            local base
            base=$(basename "$file")
            tcl_files+=("$file")
            seen_files["$base"]=1
        done < <(find "$EVENTS_DIR/local" -maxdepth 1 -type f -name "*.tcl" -print0 | sort -z)
    fi

    # Add main files
    while IFS= read -r -d '' file; do
        local base
        base=$(basename "$file")
        if [[ -z "${seen_files[$base]:-}" ]]; then
            tcl_files+=("$file")
        fi
    done < <(find "$EVENTS_DIR" -maxdepth 1 -type f -name "*.tcl" -print0 | sort -z)

    # (Rest of the menu/edit logic remains the same...)
    # ... [Insert your existing menu building and editing logic here] ...
    

    if [[ ${#tcl_files[@]} -eq 0 ]]; then
        show_result "No TCL Files" "No .tcl files found in:\n${EVENTS_DIR}"
        return
    fi

    # Build menu items
    local -a menu_items=()
    local idx=1
    for file in "${tcl_files[@]}"; do
        local display_name
        display_name=$(basename "$file")
        if [[ "$file" == "$EVENTS_DIR/local"/* ]]; then
            display_name="${display_name} (modified)"
        fi
        menu_items+=("$idx" "$display_name")
        ((idx++))
    done

    local cmd
    if [[ "$DIALOG" == "dialog" ]]; then
        cmd="dialog --colors --no-shadow --title ' Select Event Script ' --menu '\nChoose a .tcl file to edit:\n' 16 70 7"
    fi

    cmd="$cmd $(printf '%q ' "${menu_items[@]}") 2>'$DIALOG_OUT'"
    eval "$cmd" || return

    local choice
    choice=$(<"$DIALOG_OUT")

    if [[ -z "$choice" ]] || [[ ! "$choice" =~ ^[0-9]+$ ]]; then
        return
    fi

    local selected_file="${tcl_files[$((choice - 1))]}"

    if [[ ! -f "$selected_file" ]]; then
        show_result "Error" "File not found:\n${selected_file}"
        return
    fi

    if [[ ! -d "$EVENTS_DIR/local" ]]; then
        sudo mkdir -p "$EVENTS_DIR/local" || {
            show_result "Error" "Failed to create local events directory:\n${$EVENTS_DIR/local}"
            return
        }
    fi

    local original_filename
    original_filename=$(basename "$selected_file")

    local temp_file
    temp_file=$(sudo mktemp "/run/${original_filename}.XXXXXX") || {
        show_result "Error" "Failed to create temporary file"
        return
    }

    trap 'sudo rm -f "$temp_file"' RETURN

    if ! sudo cp -p "$selected_file" "$temp_file"; then
        show_result "Error" "Failed to prepare temporary file"
        return
    fi

    sudo "$EDITOR" "$temp_file"

    if cmp -s "$selected_file" "$temp_file"; then
        show_result "No Changes" "File was not modified."
        return
    fi

    local save_name
    if [[ "$DIALOG" == "dialog" ]]; then
        save_name=$(dialog --stdout --title " Save Event Script " --inputbox "\nSave as filename:" 10 60 "$original_filename")
    fi

    [[ $? -eq 0 ]] || return

    if [[ -z "$save_name" ]]; then
        show_result "Error" "Filename cannot be empty."
        return
    fi

    [[ "$save_name" != *.tcl ]] && save_name="${save_name}.tcl"
    sudo mkdir -p "$EVENTS_DIR/local" || {
        show_result "Error" "Failed to create local events directory:\n${$EVENTS_DIR/local}"
        return
    }

    local local_file="$EVENTS_DIR/local/$save_name"
    if ! sudo cp -p "$temp_file" "$local_file"; then
        show_result "Error" "Failed to save edited file to:\n${local_file}"
        return
    fi
}

# =============================================================================
# Edit Config added by VK5TRM
# =============================================================================
action_edit_config() {
    # Ensure we have a temp file for dialog output
    DIALOG_OUT=$(mktemp)
    trap "rm -f '$DIALOG_OUT'" EXIT

    # 1. Resolve Config Directory
    # We call the function directly and check its exit status
    if ! resolve_config_from_env; then
        # If the function failed, it likely printed an error. 
        # But let's be explicit in case it didn't.
        dialog --title "CRITICAL ERROR" --msgbox "Failed to resolve config path." 12 70
        return 1
    fi

    local conf_dir="$RESOLVED_CONFIG_DIR"
    
    # Debug Output (Remove this block if you want it silent in production)
#     dialog --title "[DEBUG]" --msgbox " Resolved Config Dir: $conf_dir" 10 70

    if [[ ! -d "$conf_dir" ]]; then
        dialog --title "Error" --msgbox "Config directory not found:\n$conf_dir" 10 70
        return 1
    fi

    # 2. Find all .conf files
    local -a conf_files=()
    
    # Use a subshell to avoid variable leakage, but capture output safely
    while IFS= read -r -d '' file; do
        conf_files+=("$file")
    done < <(find "$conf_dir" -maxdepth 2 -type f -name "*.conf" -print0 2>/dev/null | sort -z)

    if [[ ${#conf_files[@]} -eq 0 ]]; then
        dialog --title "No Config Files" --msgbox "No Config files found in:\n$conf_dir\n\nMake sure the directory is correct." 12 70
        return 1
    fi

    # 3. Build Menu Items
    local -a menu_items=()
    local idx=1
    for file in "${conf_files[@]}"; do
        local display_name
        display_name=$(basename "$file")
        # Escape special characters for dialog if necessary, though basename usually safe
        menu_items+=("$idx" "$display_name")
        ((idx++))
    done

    # 4. Show Selection Dialog (Direct Call, No Eval)
    local choice
    # Check if 'dialog' exists
    if ! command -v dialog &> /dev/null; then
        dialog --title "Error" --msgbox "The 'dialog' command is not installed.\n\nPlease install it (e.g., apt install dialog)." 10 70
        return 1
    fi

    # Run dialog directly
    dialog --colors --no-shadow --title " Select Config " \
        --menu "\nChoose a Config file to edit:\n" 16 70 "${#menu_items[@]}" \
        "${menu_items[@]}" 2>"$DIALOG_OUT"

    local dialog_status=$?

    if [[ $dialog_status -ne 0 ]]; then
        # User pressed Cancel or ESC
        if [[ $dialog_status -eq 255 ]]; then
             # Often indicates a display issue or cancel
             dialog --title "[DEBUG]" --msgbox " Dialog cancelled or error (Status: $dialog_status)" >&2
        fi
        rm -f "$DIALOG_OUT"
        return 0 # Return 0 to exit gracefully on cancel
    fi

    # 5. Read Choice
    if [[ ! -f "$DIALOG_OUT" ]] || [[ ! -s "$DIALOG_OUT" ]]; then
        dialog --title "Error" --msgbox "Failed to read dialog output.\n\nDialog Output File: $DIALOG_OUT" 10 70
        return 1
    fi

    choice=$(<"$DIALOG_OUT")
    rm -f "$DIALOG_OUT" # Clean up immediately

    # Validate Choice
    if [[ -z "$choice" ]] || [[ ! "$choice" =~ ^[0-9]+$ ]]; then
        dialog --title "Error" --msgbox "Invalid selection received." 8 70
        return 1
    fi

    if (( choice < 1 || choice > ${#conf_files[@]} )); then
        dialog --title "Error" --msgbox "Selection out of range.\n\nYou chose: $choice\nAvailable: ${#conf_files[@]}" 10 70
        return 1
    fi

    local selected_file="${conf_files[$((choice - 1))]}"

    # 6. Edit File
    if [[ ! -f "$selected_file" ]]; then
        dialog --title "Error" --msgbox "File not found anymore:\n$selected_file" 8 70
        return 1
    fi

    # Determine Editor
    local editor_cmd="${EDITOR:-nano}"
    if ! command -v "$editor_cmd" &> /dev/null; then
        editor_cmd="nano" # Fallback
    fi

    # Run editor
    # Using sudo -E to preserve environment if needed, or just sudo
    sudo "$editor_cmd" "$selected_file"
}

