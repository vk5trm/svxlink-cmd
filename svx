# =============================================================================
# NEW FUNCTION: List and Switch Voices from Git Repository added by VK5TRM
# =============================================================================

action_list_voices() {
    # Check if git is available
    if ! command -v git &>/dev/null; then
        show_result "Error" "git is not installed.\n\nInstall it with:\n  sudo apt install git"
        return 1
    fi

    # Ensure SOUND_DIR is set
    if [[ -z "$SOUND_DIR" ]]; then
        show_result "Error" "SOUND_DIR is not defined."
        return 1
    fi

    if [[ ! -d "$SOUND_DIR" ]]; then
        show_result "Error" "Sound directory not found:\n${SOUND_DIR}"
        return 1
    fi

    # Collect directories into an array properly
    local -a DIRS=()
    while IFS= read -r -d '' dir; do
        DIRS+=("$dir")
    done < <(find "$SOUND_DIR" -maxdepth 1 -mindepth 1 -type d -print0 | sort -z)

    if [[ ${#DIRS[@]} -eq 0 ]]; then
        show_result "No Directories found in:\n${SOUND_DIR}"
        return 1
    fi

    # Build menu items
    local -a menu_items=()
    local idx=1
    for dir in "${DIRS[@]}"; do
        local display_name
        display_name=$(basename "$dir")
        menu_items+=("$idx" "$display_name")
        ((idx++))
    done

    # Determine command based on tool availability
    local cmd
    local title_menu="Select Directory"
    local prompt_msg="Choose a directory:"

    if [[ "$DIALOG" == "dialog" ]]; then
        cmd="dialog --colors --no-shadow --title ' $title_menu ' --menu '$prompt_msg' 16 70 ${#DIRS[@]}"
    fi

    # Execute menu and capture choice
    # Note: We pass the menu items array expanded
    eval "$cmd" "${menu_items[@]}" 2>"$DIALOG_OUT"

    local choice
    choice=$(<"$DIALOG_OUT")

    if [[ -z "$choice" ]] || [[ ! "$choice" =~ ^[0-9]+$ ]]; then
        return 0 # User cancelled
    fi

    # Get the selected directory path
    local selected_dir="${DIRS[$((choice - 1))]}"

    if [[ ! -d "$selected_dir" ]]; then
        show_result "Error" "Directory not found:\n${selected_dir}"
        return 1
    fi

     # Get list of branches (voices) from the selected directory
    local -a voices=()
    local default_branch=""
    while IFS= read -r branch; do
        # Remove refs/heads/ prefix
        branch="${branch#refs/heads/}"
       if [[ "$branch" == "main" || "$branch" == "master" ]]; then
            default_branch="$branch"
            continue
        fi
        voices+=("$branch")
    done < <(git --git-dir="$selected_dir/.git" for-each-ref refs/heads/ --format='%(refname)' 2>/dev/null)
     lnk="$SOUND_DIR"'/en_US'
     if [[ ${#voices[@]} -eq 0 ]]; then
        if [[ -n "$default_branch" ]]; then
            action_switch_voice "$default_branch" "$selected_dir"
            return 0
      else
            sudo rm -rf "$lnk"
            sudo ln -sf "$selected_dir" "$lnk"
            show_result "No Branches Found" "Directory may still contain audio files."
            return 0
           fi
    fi


    # Build menu items for voices
    local -a voice_menu_items=()
    local v_idx=1
    for voice in "${voices[@]}"; do
        voice_menu_items+=("$v_idx" "$voice")
        ((v_idx++))
    done

    # Display voices menu
    if [[ "$DIALOG" == "dialog" ]]; then
        dialog --colors --no-shadow --title " Available Voices " \
            --menu "\nSelect a voice to display details:\n" 16 70 ${#voices[@]} \
            "${voice_menu_items[@]}" 2>"$DIALOG_OUT" || return 0
    fi

    local v_choice
    v_choice=$(<"$DIALOG_OUT")

    if [[ -z "$v_choice" ]] || [[ ! "$v_choice" =~ ^[0-9]+$ ]]; then
        return 0
    fi

    local selected_voice="${voices[$((v_choice - 1))]}"

    if [[ $? -eq 0 ]]; then
        action_switch_voice "$selected_voice" "$selected_dir"
    fi
}

action_switch_voice() {
    local voice_name="${1:-}"
    local target_repo="${2:-}" # Pass the repo path explicitly

    if [[ -z "$voice_name" ]]; then
        show_result "Error" "No voice specified."
        return 1
    fi

    # Check if git is available
    if ! command -v git &>/dev/null; then
        show_result "Error" "git is not installed."
        return 1
    fi

    # Check if target_repo is valid
    if [[ -z "$target_repo" ]] || [[ ! -d "$target_repo" ]]; then
        show_result "Error" "Invalid repository path: $target_repo"
        return 1
    fi

    # Perform git checkout and capture output
    local checkout_output
    local lnk="$SOUND_DIR/en_US"

    # We use --git-dir and --work-tree to be safe
    if checkout_output=$(git --git-dir="$target_repo/.git" --work-tree="$target_repo" checkout "$voice_name" 2>&1); then
        # Success: Remove old link and create new one
        sudo rm -rf "$lnk"
        sudo ln -sf "$target_repo" "$lnk"

        # Show success message in dialog
        if [[ "$DIALOG" == "dialog" ]]; then
            dialog --colors --no-shadow --title " Switch Voice Success " \
                --msgbox "Successfully switched to voice: $voice_name\n\nGit Output:\n$checkout_output" 15 60
        fi
    else
        # Failure: Show error in dialog
        if [[ "$DIALOG" == "dialog" ]]; then
            dialog --colors --no-shadow --title " Switch Voice Failed " \
                --msgbox "Failed to switch to voice: $voice_name\n\nError Git Output:\n$checkout_output" 15 60
        fi
    fi
}

action_alsamixer() {
    local usb_card=""
    if [[ -f /proc/asound/cards ]]; then
        usb_card=$(awk '/USB-Audio/{print $1; exit}' /proc/asound/cards)
    fi
    if [[ -n "$usb_card" ]]; then
        alsamixer -c "$usb_card" || true
    else
        alsamixer || true
    fi
    if ! command -v alsactl &>/dev/null; then
    show_result "Alsa Mixer" "No Alsa Control Found"
    return 1
    else
    sudo alsactl store
    show_result "Alsa Mixer" "Your Alsamixer settings have been saved"
fi
}

